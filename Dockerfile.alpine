# Multi-stage Dockerfile for ultra-lightweight (~20MB) 9Router Native Rust Container
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy the static-pie linked, LTO-optimized single binary with embedded web dashboard
COPY rust/app/target/x86_64-unknown-linux-musl/release/ninerouter /app/ninerouter

ENV PORT=20127
ENV HOST=0.0.0.0
ENV DATA_DIR=/app/data
ENV STANDALONE=1
ENV EMBED_UI=1

RUN mkdir -p /app/data && chmod +x /app/ninerouter

EXPOSE 20127
VOLUME ["/app/data"]
ENTRYPOINT ["/app/ninerouter"]
